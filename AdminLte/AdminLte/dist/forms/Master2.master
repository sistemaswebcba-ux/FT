<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Master2.master.cs" Inherits="AdminLte.dist.forms.Master2" %>
<!DOCTYPE html>
<html xmlns="http://www.w3.org/1999/xhtml" lang="es" data-bs-theme="dark">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><asp:Literal ID="PageTitle" runat="server" Text="AdminLte - Master2" /></title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="../css/adminlte.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="../../Estilo/Estilo2.css?v=dark5" />
    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>
</head>
<body class="bg-dark text-light master2-dark">
    <form id="form1" runat="server">
        <div class="master2-layout d-md-flex align-items-start">
            <nav class="navbar navbar-dark navbar-master2 master2-sidenav">
                <div class="container-fluid flex-column align-items-stretch">
                    <div class="d-flex align-items-center justify-content-between w-100">
                        <a class="navbar-brand mb-0" href="#">Futbol Argentino</a>
                        <button class="navbar-toggler d-md-none" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMaster2Menu" aria-controls="navbarMaster2Menu" aria-expanded="false" aria-label="Abrir menú">
                            <span class="navbar-toggler-icon"></span>
                        </button>
                    </div>
                    <div class="collapse d-md-block w-100" id="navbarMaster2Menu">
                        <ul class="navbar-nav flex-column w-100 mt-1 mt-md-2">
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    Primera Division
                                </a>
                                <ul class="dropdown-menu">
                                    <li><a class="dropdown-item" href="FrmTabla.aspx?Id=2&t=a">Tabla Anual</a></li>
                                    <li><a class="dropdown-item" href="FrmTabla.aspx?Id=2&t=l">Tabla Locales</a></li>
                                    <li><a class="dropdown-item" href="FrmTabla.aspx?Id=2&t=v">Tabla Visitantes</a></li>
                                    <li><a class="dropdown-item" href="#">Promedio</a></li>
                                </ul>
                            </li>
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    B Nacional Zona A
                                </a>
                                <ul class="dropdown-menu">
                                    <li><a class="dropdown-item" href="#">Tabla Anual</a></li>
                                    <li><a class="dropdown-item" href="#">Local</a></li>
                                    <li><a class="dropdown-item" href="#">Visitante</a></li>
                                </ul>
                            </li>
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    B Nacional Zona B
                                </a>
                                <ul class="dropdown-menu">
                                    <li><a class="dropdown-item" href="#">Tabla Anual</a></li>
                                    <li><a class="dropdown-item" href="#">Local</a></li>
                                    <li><a class="dropdown-item" href="#">Visitante</a></li>
                                </ul>
                            </li>
                        </ul>
                    </div>
                </div>
            </nav>

            <div class="master2-content flex-grow-1 min-w-0">
                <asp:ContentPlaceHolder ID="HeaderContent" runat="server">
                </asp:ContentPlaceHolder>
                <main class="master2-main pt-2">
                    <asp:ContentPlaceHolder ID="MainContent" runat="server">
                        <p>Contenido principal Master2 - aqui ira el contenido de cada pagina.</p>
                    </asp:ContentPlaceHolder>
                </main>
                <footer class="master2-footer">
                    <asp:ContentPlaceHolder ID="FooterContent" runat="server">
                        <p>&copy; <asp:Literal ID="CurrentYear" runat="server" /> AdminLte</p>
                    </asp:ContentPlaceHolder>
                </footer>
            </div>
        </div>
    </form>
    <script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.11.8/dist/umd/popper.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/js/bootstrap.min.js"></script>
    <script src="../js/adminlte.js"></script>
    <asp:ContentPlaceHolder ID="BottomScripts" runat="server">
    </asp:ContentPlaceHolder>
</body>
</html>
